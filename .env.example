POSTGRES_DB=travel_ml
POSTGRES_USER=travel_ml
POSTGRES_PASSWORD=travel_ml
DATABASE_URL=postgresql+psycopg://travel_ml:travel_ml@postgres:5432/travel_ml

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

MLFLOW_ENABLED=true
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_POSTGRES_DB=mlflow_tracking
MLFLOW_BACKEND_STORE_URI=postgresql+psycopg2://travel_ml:travel_ml@postgres:5432/mlflow_tracking
MLFLOW_EXPERIMENT_NAME=travel-ml-recommender
MLFLOW_UI_URL=http://localhost:5001
MLFLOW_ARTIFACT_ROOT=file:///mlflow/artifacts
MLFLOW_MODEL_NAME=poi_recommender
MLFLOW_REGISTER_MODEL=true
MLFLOW_REGISTERED_MODEL_NAME=poi_recommender
MLFLOW_LATEST_ALIAS=candidate
MLFLOW_CHAMPION_ALIAS=champion
MLFLOW_REGISTRATION_WAIT_SECONDS=120
MLFLOW_CONNECTION_RETRIES=6
MLFLOW_CONNECTION_RETRY_DELAY_SECONDS=2

INTERACTION_DATA_PATH=/app/dataset/interaction_5.csv
TRIP_DATA_DIR=/external-trip-data
MODEL_ARTIFACT_PATH=/app/backend/artifacts/poi_recommender.joblib
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

INTERACTION_SAMPLE_ROWS=250000
TRAINING_TOP_N=50
CANDIDATE_POOL_SIZE=100
BOOTSTRAP_FORCE=false
EVALUATION_DEFAULT_SAMPLE_SIZE=5
